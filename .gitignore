# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Node (only if tooling is added later)
node_modules/
npm-debug.log*
package-lock.json

# Build output for a future desktop wrap (Tauri / Electron)
dist/
build/
src-tauri/target/
spike/ui

# Scratch
*.local
tmp/
scratch/

# 구매 에셋 (LimeZu Modern Office) — 재배포 금지 라이선스라 저장소에 넣지 않는다.
# 설치 방법은 README 참고.
/assets/modern_office/
/Modern_Office_Revamped_v1.2/
*.zip
/cat/

# 위 팩에서 파생된 것들. 배포본(게임 안)에는 들어가지만 저장소에는 넣지 않는다 —
# 게임과 분리된 픽셀 뭉치를 올려 두는 건 "에셋 배포"에 해당한다.
# 만드는 법: node tools/build-atlas.js
/assets/atlas.png
/js/atlas.js

# 결제 시크릿 — 새면 누구나 다운로드 링크를 위조할 수 있고 PayPal 계정이 노출된다.
# 값은 `wrangler secret put` 으로만 넣는다. site/pay/README.md 참고.
site/pay/.dev.vars
site/pay/.wrangler/
.dev.vars
*.pem

# 폰 껍데기의 빌드 산출물 — cap sync 와 gradle 이 다시 만든다.
# (mobile/android/.gitignore 가 local.properties 와 복사된 웹 자산을 이미 막고 있고,
#  node_modules/ · build/ 는 위 규칙에 걸린다. 여기 적는 건 그 둘이 흔들려도 새지 않게.)
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/src/main/assets/public/
mobile/android/local.properties

# 애플 로그인 서명 키(.p8) — 한 번만 내려받을 수 있고, 새어 나가면 남이 우리 팀 이름으로
# 로그인 토큰을 만든다. 저장소에 절대 들이지 않는다(~/keys/ 에 둔다).
*.p8
