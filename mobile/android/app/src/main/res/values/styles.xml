<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:windowBackground">@color/copycatWindowBg</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!--
          화면을 상태바 **밑에서** 시작한다.

          targetSdk 36 부터 안드로이드는 앱을 화면 끝까지 그리게 강제한다. 그런데
          이 웹뷰는 `env(safe-area-inset-top)` 을 CSS 로 넘겨주지 않는다 — 아이폰에서
          쓴 그 방법이 여기서는 0 이 되고, 상단 띠가 시계·배터리와 겹친다
          (아이폰에서 겪은 것과 같은 고장이다).

          그래서 CSS 로 피하는 대신 **창을 그만큼 줄인다.** 그러면 env() 가 0 이어도
          맞고, 상태바 자리에는 windowBackground(게임의 어두운 색)가 남는다.

          ── 이 줄과 짝인 곳이 하나 있다 (2026-09-21) ──
          여기서 창을 줄이므로 CSS 는 위쪽 안전영역을 또 내면 안 된다. 그런데
          안드로이드의 env(safe-area-inset-top) 은 상태바가 아니라 디스플레이
          컷아웃(펀치홀·노치)을 재서, 창이 줄어 있어도 0 이 아니다 — 펀치홀이 있는
          기기에서만 상단에 빈 띠가 남았다. 그래서 js/col.js 가 안드로이드에서
          CSS 변수 safet 을 0 으로 덮는다(style.css 의 그 변수 머리말에 이유가 있다).

          이 fitsSystemWindows 를 빼는 날 그 한 줄도 같이 빼야 한다. 한쪽만 고치면
          상단 띠가 상태바와 겹치거나(빼면) 빈 띠가 남는다(넣으면).

          (XML 주석에는 붙임표 둘을 못 쓴다 — CSS 변수 이름을 그대로 적으면
           빌드가 「not well-formed」 하나로 죽는다.)
        -->
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/copycatWindowBg</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/copycatWindowBg</item>
        <item name="android:background">@drawable/splash</item>
    </style>
    <!-- 켤 때 보이는 색. 게임이 어두운 화면으로 시작하므로 흰색이면 번쩍인다. -->
    <color name="copycatWindowBg">#171310</color>
</resources>