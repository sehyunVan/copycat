# 이 파일을 keystore.properties 로 복사해서 값을 채운다.
#
# **keystore.properties 와 .jks 는 저장소에 넣지 않는다.** 이 열쇠를 가진 사람은
# 당신 이름으로 앱을 올릴 수 있다. 잃어버려도 곤란하다 — Play 앱 서명을 쓰면 업로드
# 키는 재발급받을 수 있지만 며칠 걸리고, 안 쓰면 같은 앱을 영영 못 고친다.
# 만들면 바로 다른 곳에(비밀번호 관리자·외장 디스크) 복사해 둘 것.
#
# 열쇠 만들기 — 한 번만 한다:
#   keytool -genkeypair -v -keystore C:/Users/<나>/keys/copycat-upload.jks \
#           -alias copycat -keyalg RSA -keysize 2048 -validity 10000
#   (keytool 은 JDK 안에 있다: "C:/Program Files/Android/Android Studio/jbr/bin/keytool")

# .jks 파일의 **전체 경로**. 역슬래시 대신 슬래시를 쓴다.
storeFile=C:/Users/sehyu/keys/copycat-upload.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=copycat
keyPassword=여기에_키_비밀번호
